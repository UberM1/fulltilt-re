+		control::score_components, 88, control::simple_components, 145,
+		false, false, &control_lite198_tag, &control::MissionControl, false,
+		nullptr, nullptr, nullptr, nullptr,
+		"TABA", 3, "DEMO", nullptr, 0,
+	},
