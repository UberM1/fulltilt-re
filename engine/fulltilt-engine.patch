+	if (track <= 0 || static_cast<size_t>(track) >= TableTracks.size())
+		return;
+
+	// A table may legitimately be missing a track -- the Full Tilt demo ships one --
+	// so a null entry is silence, not an error.
+	auto music = TableTracks[track];
+	if (!music)
+		return;
+
