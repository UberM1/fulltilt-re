diff --git a/SpaceCadetPinball/TPinballTable.cpp b/SpaceCadetPinball/TPinballTable.cpp
index aa8551a..3ea177d 100644
--- a/SpaceCadetPinball/TPinballTable.cpp
+++ b/SpaceCadetPinball/TPinballTable.cpp
@@ -178,9 +178,46 @@ TPinballTable::TPinballTable(): TPinballComponent(nullptr, -1, false)
 			case 1033:
 				new TTextBox(this, groupIndex);
 				break;
+
+			// Full Tilt's bonus tables use seven object types 3D Pinball never had, and
+			// no class for them survives in any decompilation. These map each onto the
+			// nearest existing class so the tables load, draw and behave approximately;
+			// they are stand-ins, not reconstructions, and the components carry their
+			// real type code via GetComponentType() so the rules still discriminate
+			// correctly. Recovering the real classes means disassembling their
+			// constructors in DRAGON.EXE and PIRATES.EXE.
+			case 1034: // s_launcher1: Skulduggery's ball launcher. No plunger on that table.
+				Plunger = new TPlunger(this, groupIndex);
+				break;
+			case 1035: // s_rexit*: ramp exits, one ramp wall each.
+				new TRamp(this, groupIndex);
+				break;
+			case 1036: // a_accl*: accelerators, a wall plus a kicker.
+				new TKickout(this, groupIndex, false);
+				break;
+			case 1037: // a point on a collision layer.
+				new TWall(this, groupIndex);
+				break;
+			case 1038: // light_sweeps: light show settings, no physics.
+				new TLightGroup(this, groupIndex);
+				break;
+			case 1042: // s_magnet*: a circle and a field strength.
+				new TKickout(this, groupIndex, false);
+				break;
+			case 1043: // a_dvtr*: diverters.
+				new TBlocker(this, groupIndex);
+				break;
+
 			default:
 				continue;
 			}
+
+			// Every branch above ends in exactly one construction, and the
+			// TPinballComponent constructor appends to ComponentList, so the object
+			// just spawned is the last entry. Stamping the type here keeps the
+			// knowledge in the one place that already has it.
+			if (!ComponentList.empty())
+				ComponentList.back()->ComponentType = objectType;
 		}
 	}
 
