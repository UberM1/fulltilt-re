diff --git a/SpaceCadetPinball/TAccelerator.cpp b/SpaceCadetPinball/TAccelerator.cpp
new file mode 100644
index 0000000..b9c2a93
--- /dev/null
+++ b/SpaceCadetPinball/TAccelerator.cpp
@@ -0,0 +1,71 @@
+#include "pch.h"
+#include "TAccelerator.h"
+
+#include "control.h"
+#include "loader.h"
+#include "TBall.h"
+#include "TPinballTable.h"
+#include "TTableLayer.h"
+
+TAccelerator::TAccelerator(TPinballTable* table, int groupIndex) : TCollisionComponent(table, groupIndex, true)
+{
+	visualStruct visual{};
+	loader::query_visual(groupIndex, 0, &visual);
+
+	ThrowDirection = visual.Kicker.ThrowBallDirection;
+	ThrowAngleMult = visual.Kicker.ThrowBallAngleMult;
+	ThrowSpeedMult1 = visual.Kicker.Boost;
+	// The same 1/100 the kicker's throw multiplier gets everywhere else in the engine.
+	ThrowSpeedMult2 = visual.Kicker.ThrowBallMult * 0.01f;
+	SoundIndex4 = visual.SoundIndex4;
+
+	// 1.8 is the original's constant, and it is the full extent being halved and then
+	// widened: extent / 1.8 is half-extent / 0.9, so the circle clears the wall by a
+	// tenth. The larger axis wins, so a long thin accelerator still covers its own wall.
+	circle_type circle{};
+	circle.Center.X = (AABB.XMin + AABB.XMax) / 2.0f;
+	circle.Center.Y = (AABB.YMin + AABB.YMax) / 2.0f;
+	auto radius = std::max((AABB.YMax - AABB.YMin) / 1.8f, (AABB.XMax - AABB.XMin) / 1.8f);
+	circle.RadiusSq = radius * radius;
+
+	Field.ActiveFlag = &ActiveFlag;
+	Field.CollisionComp = this;
+	Field.CollisionGroup = visual.CollisionGroup;
+	TTableLayer::edges_insert_circle(&circle, nullptr, &Field);
+}
+
+void TAccelerator::Collision(TBall* ball, vector2* nextPosition, vector2* direction, float distance,
+                             TEdgeSegment* edge)
+{
+	// The wall does not push back -- the ball goes through it and gets accelerated
+	// instead, so there is no basic_collision here either.
+	ball->not_again(edge);
+	ball->RayMaxDistance -= distance;
+	ball->Position.X = nextPosition->X;
+	ball->Position.Y = nextPosition->Y;
+
+	// A tilted table is inert: the ball crosses the wall and nothing is armed, which
+	// leaves the field with nothing to throw.
+	if (PinballTable->TiltLockFlag)
+		return;
+
+	Ball = ball;
+	ball->CollisionDisabledFlag = true;
+	loader::play_sound(SoundIndex4, ball, "TAccelerator");
+	control::handler(MessageCode::ControlCollision, this);
+}
+
+int TAccelerator::FieldEffect(TBall* ball, vector2* vecDst)
+{
+	// Only the ball the wall armed, and only once: clearing Ball here is what makes the
+	// kick one-shot. Every other ball crossing the field sees nothing.
+	if (Ball != ball)
+		return 0;
+
+	Ball = nullptr;
+	ball->throw_ball(&ThrowDirection, ThrowAngleMult, ThrowSpeedMult1, ThrowSpeedMult2);
+
+	// Zero either way: the throw has already set the ball's direction and speed outright,
+	// so there is no force for the caller to add on top of it.
+	return 0;
+}
diff --git a/SpaceCadetPinball/TAccelerator.h b/SpaceCadetPinball/TAccelerator.h
new file mode 100644
index 0000000..7eae76f
--- /dev/null
+++ b/SpaceCadetPinball/TAccelerator.h
@@ -0,0 +1,49 @@
+#pragma once
+#include "maths.h"
+#include "TCollisionComponent.h"
+#include "TEdgeManager.h"
+
+// Object type 1036 -- `a_accl*`, recovered from CADET.EXE: constructor 0x41b7d0,
+// Collision 0x41b8f0, FieldEffect 0x41b9f0, vtable 0x437800, object size 0xa6. CADET's
+// own TPinballTable constructor spawns it for type 0x40c. Dragon's Keep has four,
+// Skulduggery two.
+//
+// It is a kicker turned inside out, and the only Full-Tilt-only class that asks the
+// collision component for the standard attribute-600 wall (createWall = true). That
+// wall is all the geometry it has, and its only job is to mark which ball to push: the
+// push itself happens in FieldEffect, on the next evaluation of a field circle laid
+// over the component's own AABB.
+//
+// So the sequence is: ball hits the wall -> the wall notes the ball, plays the
+// component's 1100 sound and raises ControlCollision -> the ball, still inside the
+// field, is thrown along the kicker's own direction with the kicker's own multipliers,
+// exactly the throw_ball call TKickout makes when its timer expires. That is why a
+// TKickout stand-in moved the ball wrongly rather than merely approximately: a
+// kickout's field pulls the ball toward a centre and parks it, an accelerator's pushes
+// it along a fixed direction and never takes it out of play.
+//
+// FieldEffect returns 0 in both branches, so there is no continuous force -- the
+// accelerator is a one-shot kick, and between kicks its field costs nothing.
+class TAccelerator : public TCollisionComponent
+{
+public:
+	TAccelerator(TPinballTable* table, int groupIndex);
+	void Collision(TBall* ball, vector2* nextPosition, vector2* direction, float distance,
+	               TEdgeSegment* edge) override;
+	int FieldEffect(TBall* ball, vector2* vecDst) override;
+
+private:
+	// The ball that hit the wall and has not been thrown yet. One at a time: a second
+	// ball arriving before the field fires replaces the first, which is the original's
+	// behaviour and not a bug worth fixing here.
+	TBall* Ball{};
+
+	// Straight out of visual.Kicker, under TKickout's names for the same four values.
+	vector3 ThrowDirection{};
+	float ThrowAngleMult{};
+	float ThrowSpeedMult1{};
+	float ThrowSpeedMult2{};
+
+	int SoundIndex4{};
+	field_effect_type Field{};
+};
