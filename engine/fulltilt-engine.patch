+		        " timerTime=%.4f ballPos=(%.3f,%.3f) s3=%d s4=%d\n",
+		        name ? name : "?", comp, aabb.XMin, aabb.XMax, aabb.YMin, aabb.YMax, group,
+		        timerTime, ballPos.X, ballPos.Y, s3, s4);
+}
